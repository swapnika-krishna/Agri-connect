# AgriConnect Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/agriconnect

# JWT Authentication Secret and Expiration
JWT_SECRET=agriconnect_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=7d

# data.gov.in Agmarknet Mandi Commodity Price API Key
# Register at https://data.gov.in to get an API key
AGMARKET_API_KEY=your_datagov_in_api_key_here

# Weather API Key (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Frontend Application Client URL (for CORS)
CLIENT_URL=http://localhost:3000
